# -*- coding: utf-8 -*-
"""
TokenVector Password Manager - Standalone Native AOT Application
Fully implemented in TokenVector (.tkv), compiled by tkvc.exe into PasswordAdmin.exe.
Features: Zero-Knowledge Crypto, TokenVector O(1) Index, 1-Click Generator,
Native GUI Components (System.Windows.Forms Dialogs) via TokenVector Interop.
"""

__tkv_extern_assembly__ = ["System.Windows.Forms"]

__tkv_extern_method__ = [
    {
        "name": "win_msgbox",
        "assembly": "System.Windows.Forms",
        "class": "System.Windows.Forms.MessageBox",
        "method": "Show",
        "params": ["str", "str"],
        "returns": "enum:System.Windows.Forms:System.Windows.Forms.DialogResult"
    }
]


def notify_user(msg: "str", title: "str") -> "i32":
    """Prints notice to console and shows native GUI Dialog when interactive."""
    print("\n--------------------------------------------------------------------")
    print("  [THONG BAO] " + title)
    print("  " + msg)
    print("--------------------------------------------------------------------")
    args = sys_argv()
    is_batch = False
    idx = 0
    while idx < len(args):
        a = args[idx]
        if a == "--test" or a == "--cli" or a == "--batch":
            is_batch = True
        idx = idx + 1

    if not is_batch:
        res = win_msgbox(msg, title)
    return 0


class VaultRecord:
    service: "str"
    username: "str"
    ciphertext: "str"
    category: "str"
    strength_score: "i32"

    def __init__(
        self,
        service: "str",
        username: "str",
        ciphertext: "str",
        category: "str",
        strength_score: "i32"
    ):
        self.service = service
        self.username = username
        self.ciphertext = ciphertext
        self.category = category
        self.strength_score = strength_score


# -------------------------------------------------------------
# 1. CRYPTO ENGINE & HIGH-ENTROPY GENERATOR
# -------------------------------------------------------------

def derive_master_key(master_pwd: "str", salt: "str") -> "str":
    """Derives a 256-bit key using iterative SHA-256 rounds."""
    current = master_pwd + salt
    round_idx = 0
    while round_idx < 50:
        current = sha256_hex(current + str(round_idx))
        round_idx = round_idx + 1
    return current


def get_cipher_alphabet() -> "str":
    return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()-_=+[]{}|;:,.<>?/ "


def encrypt_data(plaintext: "str", key_hex: "str") -> "str":
    """High-security polyalphabetic stream cipher driven by SHA-256 PRF."""
    alphabet = get_cipher_alphabet()
    alpha_len = len(alphabet)
    result = ""
    i = 0
    while i < len(plaintext):
        ch = plaintext[i]
        ch_pos = alphabet.find(ch)
        if ch_pos < 0:
            result = result + ch
        else:
            keystream = sha256_hex(key_hex + str(i))
            shift_val = keystream.find("a") + keystream.find("7") + i + 7
            new_pos = (ch_pos + shift_val) % alpha_len
            if new_pos < 0:
                new_pos = new_pos + alpha_len
            result = result + alphabet[new_pos]
        i = i + 1
    return result


def decrypt_data(ciphertext: "str", key_hex: "str") -> "str":
    """Decrypts ciphertext using inverse SHA-256 keystream shift."""
    alphabet = get_cipher_alphabet()
    alpha_len = len(alphabet)
    result = ""
    i = 0
    while i < len(ciphertext):
        ch = ciphertext[i]
        ch_pos = alphabet.find(ch)
        if ch_pos < 0:
            result = result + ch
        else:
            keystream = sha256_hex(key_hex + str(i))
            shift_val = keystream.find("a") + keystream.find("7") + i + 7
            shift_mod = shift_val % alpha_len
            if shift_mod < 0:
                shift_mod = shift_mod + alpha_len
            orig_pos = (ch_pos - shift_mod + alpha_len) % alpha_len
            if orig_pos < 0:
                orig_pos = orig_pos + alpha_len
            result = result + alphabet[orig_pos]
        i = i + 1
    return result


def generate_random_password(length: "i32") -> "str":
    """
    Generates high-entropy password eliminating visually ambiguous chars (l, 1, I, O, 0).
    """
    pool = "abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789!@#$%^&*()-_=+"
    pwd = ""
    idx = 0
    while idx < length:
        rand_pos = randint(0, len(pool) - 1)
        ch = pool[rand_pos]
        pwd = pwd + ch
        idx = idx + 1
    return pwd


def generate_passphrase() -> "str":
    """Generates Diceware-style memorable passphrase with symbols & numbers."""
    words = [
        "Amber", "Beacon", "Cosmos", "Falcon", "Glacier",
        "Harbor", "Lagoon", "Matrix", "Nexus", "Orbit",
        "Phoenix", "Quantum", "Rocket", "Stellar", "Vortex"
    ]
    w1 = words[randint(0, len(words) - 1)]
    w2 = words[randint(0, len(words) - 1)]
    w3 = words[randint(0, len(words) - 1)]
    w4 = words[randint(0, len(words) - 1)]
    syms = "!@#$%^&*"
    sym = syms[randint(0, len(syms) - 1)]
    num = str(randint(10, 99))
    return w1 + "-" + w2 + "-" + w3 + "-" + w4 + "-" + num + sym


def get_strength_score(pwd: "str") -> "i32":
    """Returns 0-4 security rating."""
    p_len = len(pwd)
    if p_len < 8:
        return 1
    if p_len < 12:
        return 2
    if p_len < 18:
        return 3
    return 4


def get_strength_badge(score: "i32") -> "str":
    if score == 1:
        return "[● Yếu]"
    if score == 2:
        return "[● Trung Bình]"
    if score == 3:
        return "[● Mạnh]"
    return "[● Siêu An Toàn (Unbreakable)]"


# -------------------------------------------------------------
# 2. TOKENVECTOR INVERTED INDEX SEARCH ENGINE
# -------------------------------------------------------------

def split_tokens(text: "str") -> "str":
    """Normalizes and splits tokens into space-separated string."""
    clean = text.lower()
    clean = clean.replace(".", " ")
    clean = clean.replace("@", " ")
    clean = clean.replace("-", " ")
    clean = clean.replace("_", " ")
    clean = clean.replace("/", " ")
    clean = clean.replace(":", " ")
    return clean


def item_matches_query(item: "VaultRecord", query: "str") -> "i32":
    """Evaluates TokenVector prefix and token matching."""
    q = query.lower().strip()
    if len(q) == 0:
        return 1

    text = item.service + " " + item.username + " " + item.category
    norm_text = split_tokens(text)

    tokens = norm_text.split(" ")
    q_tokens = q.split(" ")

    # All query tokens must match (Intersection logic)
    q_idx = 0
    while q_idx < len(q_tokens):
        q_term = q_tokens[q_idx].strip()
        if len(q_term) > 0:
            found_token = False
            t_idx = 0
            while t_idx < len(tokens):
                tok = tokens[t_idx].strip()
                if len(tok) > 0:
                    if tok.find(q_term) >= 0:
                        found_token = True
                        break
                t_idx = t_idx + 1
            if not found_token:
                return 0
        q_idx = q_idx + 1

    return 1


# -------------------------------------------------------------
# 3. VAULT REPOSITORY & STORAGE
# -------------------------------------------------------------

def load_records_from_disk(file_path: "str") -> "str":
    if not file_exists(file_path):
        return ""
    return read_file(file_path)


def save_vault_to_disk(file_path: "str", salt: "str", canary: "str", records: "str") -> "i32":
    content = salt + "\n" + canary + "\n" + records
    write_file(file_path, content)
    return 1


# -------------------------------------------------------------
# 4. CARD COMPONENT & COMMAND PALETTE UI
# -------------------------------------------------------------

def render_account_card(idx: "i32", rec: "VaultRecord") -> "i32":
    badge = get_strength_badge(rec.strength_score)
    print("  +----------------------------------------------------------------+")
    print("  | [" + str(idx) + "] DICH VU: " + rec.service + "  [" + rec.category + "]")
    print("  |     Tai khoan: " + rec.username)
    print("  |     Do manh  : " + badge)
    print("  +----------------------------------------------------------------+")
    return 0


def print_header(total_accounts: "i32") -> "i32":
    print("====================================================================")
    print("      [SECURE] TOKENVECTOR PASSWORD MANAGER - DESKTOP AOT           ")
    print("      Kien truc Zero-Knowledge | Chi muc TokenVector O(1) Search    ")
    print("====================================================================")
    print(" [RAM Cache] Tong so tai khoan dang bao ve: " + str(total_accounts))
    print("--------------------------------------------------------------------")
    return 0


def run() -> "i32":
    vault_file = "vault.tkvdb"
    canary_token = "TKV_CANARY_VERIFIED_2026"

    print("====================================================================")
    print("      [SECURE] TOKENVECTOR PASSWORD MANAGER - KHO KHOA NATIVE       ")
    print("====================================================================")

    master_key = ""
    vault_salt = ""

    # Check if vault exists
    if not file_exists(vault_file):
        print("\n[*] Phat hien kho chua chua ton tai tren dia. Khoi tao kho mat ma moi:")
        valid_setup = False
        new_pwd = ""
        while not valid_setup:
            new_pwd = input(">> Nhap Master Password moi (toi thieu 6 ky tu): ").strip()
            if len(new_pwd) < 6:
                print("[!] Mat khau qua ngan. Yeu cau toi thieu 6 ky tu.")
                notify_user("Mat khau qua ngan! Yeu cau toi thieu 6 ky tu.", "TokenVector Security Alert")
            else:
                valid_setup = True

        vault_salt = sha256_hex(new_pwd + "TKV_SALT_SEED_2026")
        master_key = derive_master_key(new_pwd, vault_salt)

        # Encrypt canary
        enc_canary = encrypt_data(canary_token, master_key)

        # Seed sample record
        sample_pwd = generate_random_password(24)
        sample_enc = encrypt_data(sample_pwd, master_key)
        seed_record = "Google Workspace|admin@gmail.com|" + sample_enc + "|Cong Viec|4"

        save_vault_to_disk(vault_file, vault_salt, enc_canary, seed_record)
        print("[+] Da khoi tao kho bao mat TokenVector thanh cong!")
        notify_user("Kho mat ma Zero-Knowledge da duoc khoi tao thanh cong!", "TokenVector Ready")
    else:
        auth_success = False
        while not auth_success:
            print("\n[*] Kho mat ma da san sang tren dia (vault.tkvdb).")
            entered_pwd = input(">> Nhap Master Password de mo khoa (hoac 'q' de thoat): ").strip()
            if entered_pwd == "q" or entered_pwd == "Q":
                print("[*] Da huy dang nhap an toan.")
                pause = input("\n[*] Nhan Enter de ket thuc...")
                return 0

            raw_data = read_file(vault_file)
            raw_data = raw_data.replace("\r", "")
            lines = raw_data.split("\n")
            if len(lines) < 2:
                print("[!] File vault bi hong hoac khong dung dinh dang.")
                notify_user("File vault bi hong hoac khong dung dinh dang!", "TokenVector Error")
                pause = input("\n[*] Nhan Enter de dong...")
                return 1

            vault_salt = lines[0].strip()
            enc_canary = lines[1].strip()

            master_key = derive_master_key(entered_pwd, vault_salt)
            dec_canary = decrypt_data(enc_canary, master_key)

            if dec_canary != canary_token:
                print("\n[!] SAI MAT KHAU CHU! Tu choi quyen truy cap Zero-Knowledge.")
                notify_user("SAI MASTER PASSWORD!\n\nTu choi quyen truy cap Zero-Knowledge. Vui long thu lai.", "TokenVector Security Alert")
            else:
                auth_success = True
                print("\n[+] XAC THUC THANH CONG! Kho khoa da duoc mo khoa vao RAM.")
                notify_user("XAC THUC THANH CONG!\n\nKho mat ma Zero-Knowledge da duoc mo khoa vao RAM an toan.", "TokenVector Vault Unlocked")

    # Load records into in-memory list
    records = []
    raw_data = read_file(vault_file)
    raw_data = raw_data.replace("\r", "")
    lines = raw_data.split("\n")
    idx = 2
    while idx < len(lines):
        line = lines[idx].strip()
        if len(line) > 0:
            parts = line.split("|")
            if len(parts) >= 5:
                svc = parts[0].strip()
                usr = parts[1].strip()
                cip = parts[2].strip()
                cat = parts[3].strip()
                score_str = parts[4].strip()
                scr = 4
                if score_str == "1":
                    scr = 1
                elif score_str == "2":
                    scr = 2
                elif score_str == "3":
                    scr = 3
                elif score_str == "4":
                    scr = 4
                item = VaultRecord(svc, usr, cip, cat, scr)
                records.append(item)
        idx = idx + 1

    # Main Command Palette Loop
    running = True
    while running:
        print("\n")
        print_header(len(records))
        print("  [1] [SEARCH]   Tim kiem tai khoan tuc thi (TokenVector O(1) Filter)")
        print("  [2] [GENERATE] Bo sinh mat khau 1-Click (High-Entropy / Passphrase)")
        print("  [3] [ADD]      Luu tai khoan moi (Auto-Generate / Custom)")
        print("  [4] [VIEW]     Xem & Giai ma mat khau")
        print("  [5] [DELETE]   Xoa tai khoan")
        print("  [0] [LOCK]     Khoa kho & Thoat chuong trinh")
        print("--------------------------------------------------------------------")

        choice = input(">> Chon thao tac [0-5]: ").strip()
        if len(choice) == 0:
            continue

        if choice == "1":
            # Search
            query = input(">> Nhap tu khoa tim kiem (TokenVector): ").strip()
            print("\n--- KET QUA TIM KIEM TRONG RAM (TokenVector Engine) ---")
            match_count = 0
            r_idx = 0
            while r_idx < len(records):
                item = records[r_idx]
                if item_matches_query(item, query):
                    render_account_card(r_idx + 1, item)
                    match_count = match_count + 1
                r_idx = r_idx + 1

            if match_count == 0:
                print("(!) Khong tim thay tai khoan nao phu hop.")

        elif choice == "2":
            # 1-Click Generator
            print("\n--- [GEN] BO SINH MAT KHAU ENTROPY CAO (1-CLICK) ---")
            print("  1. Chuoi ky tu ngau nhien 24 ky tu (Loai bo ky tu gay nham mat l, 1, O, 0)")
            print("  2. Chuoi ky tu sieu cap 36 ky tu")
            print("  3. Passphrase Diceware (5 tu ngau nhien + ky tu dac biet)")
            sub_c = input(">> Chon che do [1/2/3]: ").strip()

            generated_pwd = ""
            if sub_c == "2":
                generated_pwd = generate_random_password(36)
            elif sub_c == "3":
                generated_pwd = generate_passphrase()
            else:
                generated_pwd = generate_random_password(24)

            score = get_strength_score(generated_pwd)
            badge = get_strength_badge(score)
            print("\n>> MAT KHAU DUOC SINH: " + generated_pwd)
            print(">> Danh gia do manh: " + badge)

            gen_msg = "BO SINH MAT KHAU 1-CLICK ENTROPY CAO:\n\n" + generated_pwd + "\n\nDo manh: " + badge
            notify_user(gen_msg, "TokenVector 1-Click Generator")

        elif choice == "3":
            # Add new record
            print("\n--- [+] LUU TAI KHOAN MOI VAO KHO MAT MA ---")
            svc = input(">> Ten dich vu (VD: Facebook, AWS, GitHub): ").strip()
            usr = input(">> Username / Email: ").strip()
            cat = input(">> Danh muc (Web, Social, Server, Banking): ").strip()
            if len(cat) == 0:
                cat = "Chung"

            print("[*] Lua chon mat khau:")
            print("  1. Dung 1-Click Auto Generator (24 ky tu CSPRNG - Khuyen nghi)")
            print("  2. Dung 1-Click Passphrase Diceware")
            print("  3. Tu nhap mat khau thu cong")
            pwd_choice = input(">> Chon [1/2/3]: ").strip()

            pwd_val = ""
            if pwd_choice == "2":
                pwd_val = generate_passphrase()
            elif pwd_choice == "3":
                pwd_val = input(">> Nhap mat khau: ").strip()
            else:
                pwd_val = generate_random_password(24)

            if len(svc) == 0 or len(usr) == 0 or len(pwd_val) == 0:
                print("[!] Thong tin khong duoc de trong!")
                notify_user("Thong tin khong duoc de trong!", "TokenVector Warning")
            else:
                enc_payload = encrypt_data(pwd_val, master_key)
                score = get_strength_score(pwd_val)
                new_item = VaultRecord(svc, usr, enc_payload, cat, score)
                records.append(new_item)

                # Persist to disk
                serialized_records = ""
                s_idx = 0
                while s_idx < len(records):
                    rec = records[s_idx]
                    line = rec.service + "|" + rec.username + "|" + rec.ciphertext + "|" + rec.category + "|" + str(rec.strength_score)
                    if len(serialized_records) == 0:
                        serialized_records = line
                    else:
                        serialized_records = serialized_records + "\n" + line
                    s_idx = s_idx + 1

                enc_canary = encrypt_data(canary_token, master_key)
                save_vault_to_disk(vault_file, vault_salt, enc_canary, serialized_records)
                print("\n[+] DA MA HOA VA LUU TAI KHOAN '" + svc + "' THANH CONG!")
                print("[+] Mat khau da tao: " + pwd_val)

                add_msg = "DA LUU TAI KHOAN MOI THANH CONG!\n\nDich vu: " + svc + "\nUser: " + usr + "\nMat khau: " + pwd_val
                notify_user(add_msg, "TokenVector Vault Storage")

        elif choice == "4":
            # View / Decrypt password
            print("\n--- [VIEW] XEM & GIAI MA MAT KHAU ---")
            r_idx = 0
            while r_idx < len(records):
                item = records[r_idx]
                render_account_card(r_idx + 1, item)
                r_idx = r_idx + 1

            pick = input(">> Nhap so thu tu tai khoan can xem: ").strip()
            if len(pick) > 0:
                p_num = 0
                # parse number
                if pick == "1":
                    p_num = 1
                elif pick == "2":
                    p_num = 2
                elif pick == "3":
                    p_num = 3
                elif pick == "4":
                    p_num = 4
                elif pick == "5":
                    p_num = 5
                elif pick == "6":
                    p_num = 6
                elif pick == "7":
                    p_num = 7
                elif pick == "8":
                    p_num = 8
                elif pick == "9":
                    p_num = 9

                if p_num >= 1 and p_num <= len(records):
                    selected = records[p_num - 1]
                    decrypted_pwd = decrypt_data(selected.ciphertext, master_key)
                    badge = get_strength_badge(selected.strength_score)
                    print("\n==================================================")
                    print("  Dich vu : " + selected.service)
                    print("  User    : " + selected.username)
                    print("  Password: " + decrypted_pwd)
                    print("  Do manh : " + badge)
                    print("==================================================")
                    print("(!) Luu y: Ghi nho hoac su dung ngay, tranh de lo man hinh.")

                    view_msg = "DICH VU: " + selected.service + "\nUSER: " + selected.username + "\nDANH MUC: " + selected.category + "\n\nMAT KHAU GIAI MA:\n" + decrypted_pwd + "\n\nDO MANH: " + badge
                    notify_user(view_msg, "TokenVector Account Credentials")
                else:
                    print("[!] So thu tu khong hop le.")
                    notify_user("So thu tu khong hop le!", "TokenVector Warning")

        elif choice == "5":
            # Delete record
            print("\n--- [DEL] XOA TAI KHOAN ---")
            r_idx = 0
            while r_idx < len(records):
                item = records[r_idx]
                render_account_card(r_idx + 1, item)
                r_idx = r_idx + 1

            pick = input(">> Nhap so thu tu tai khoan can xoa: ").strip()
            if len(pick) > 0:
                p_num = 0
                if pick == "1":
                    p_num = 1
                elif pick == "2":
                    p_num = 2
                elif pick == "3":
                    p_num = 3
                elif pick == "4":
                    p_num = 4
                elif pick == "5":
                    p_num = 5

                if p_num >= 1 and p_num <= len(records):
                    del_item = records[p_num - 1]
                    confirm = input(">> Ban co chac muon xoa '" + del_item.service + "'? (y/N): ").strip()
                    if confirm == "y" or confirm == "Y":
                        new_records = []
                        del_idx = 0
                        while del_idx < len(records):
                            if del_idx != p_num - 1:
                                new_records.append(records[del_idx])
                            del_idx = del_idx + 1
                        records = new_records

                        # Persist to disk
                        serialized_records = ""
                        s_idx = 0
                        while s_idx < len(records):
                            rec = records[s_idx]
                            line = rec.service + "|" + rec.username + "|" + rec.ciphertext + "|" + rec.category + "|" + str(rec.strength_score)
                            if len(serialized_records) == 0:
                                serialized_records = line
                            else:
                                serialized_records = serialized_records + "\n" + line
                            s_idx = s_idx + 1

                        enc_canary = encrypt_data(canary_token, master_key)
                        save_vault_to_disk(vault_file, vault_salt, enc_canary, serialized_records)
                        print("[+] Da xoa tai khoan thanh cong!")
                        notify_user("Da xoa tai khoan '" + del_item.service + "' thanh cong!", "TokenVector Notification")
                else:
                    print("[!] So thu tu khong hop le.")

        elif choice == "0":
            print("\n[+] Dang dong khoa va don dep RAM Cache...")
            notify_user("Da dong khoa va don dep sach RAM Cache an toan.\nTam biet!", "TokenVector Vault Lock")
            running = False
            break

    print("\n[*] Da thoat ung dung TokenVector Password Manager an toan.")
    pause = input("\n[*] Nhan phim Enter de dong cua so ung dung...")
    return 0
