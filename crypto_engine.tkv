# -*- coding: utf-8 -*-
"""
TokenVector Password Manager - Cryptographic Security Engine
Implements CSPRNG, Argon2id/PBKDF2 Key Derivation, AES-256-GCM AEAD,
and High-Entropy Password/Passphrase Generation.
"""

import os
import math
import secrets
import hashlib
import base64
import time
from typing import Tuple, List, Dict, Optional

# Attempt to load native AES-GCM from cryptography module; fallback to CTR+HMAC AEAD if unavailable
_CRYPTO_BACKEND = "STANDALONE"
try:
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    _CRYPTO_BACKEND = "CRYPTOGRAPHY_GCM"
except ImportError:
    AESGCM = None

# Attempt to load Argon2id; fallback to PBKDF2-HMAC-SHA256 (600,000 rounds) if unavailable
_ARGON2_AVAILABLE = False
try:
    import argon2.low_level as argon2_ll
    _ARGON2_AVAILABLE = True
except ImportError:
    argon2_ll = None


# Visual ambiguity character blacklist
AMBIGUOUS_CHARS = set("l1IO0|`'\";:.,~")

# Standard character sets excluding ambiguous characters
CHAR_UPPER = "ABCDEFGHJKLMNPQRSTUVWXYZ"
CHAR_LOWER = "abcdefghijkmnopqrstuvwxyz"
CHAR_DIGITS = "23456789"
CHAR_SYMBOLS = "!@#$%^&*()-_=+[]{}<>?"

# High-entropy Diceware wordlist for memorable passphrases
DICEWARE_WORDS = [
    "amber", "anchor", "arcade", "artist", "beacon", "blazer", "breeze", "cactus",
    "canvas", "canyon", "castle", "cipher", "comet", "cosmos", "crater", "crystal",
    "desert", "diver", "dragon", "falcon", "fender", "galaxy", "glacier", "harbor",
    "horizon", "island", "jasper", "jungle", "lagoon", "lantern", "legend", "matrix",
    "meteor", "nebula", "nexus", "oasis", "orbit", "phoenix", "planet", "plasma",
    "portal", "prism", "pulsar", "pyramid", "quantum", "radar", "radius", "rocket",
    "safari", "saturn", "shadow", "shield", "silver", "solstice", "stellar", "summit",
    "thunder", "timber", "titan", "torque", "vector", "vertex", "vortex", "zenith"
]


class CryptoEngine:
    """Cryptographic core ensuring Zero-Knowledge vault security."""

    @staticmethod
    def generate_salt(length: "i32" = 32) -> bytes:
        """Generates CSPRNG random cryptographic salt using OS hardware entropy."""
        return secrets.token_bytes(length)

    @staticmethod
    def derive_key(master_password: "str", salt: bytes) -> Tuple[bytes, "str"]:
        """
        Derives a 256-bit (32 bytes) master key using Argon2id if available,
        or PBKDF2-HMAC-SHA256 with 600,000 iterations (OWASP recommended).
        """
        pwd_bytes = master_password.encode("utf-8")
        if _ARGON2_AVAILABLE:
            try:
                key = argon2_ll.hash_secret_raw(
                    secret=pwd_bytes,
                    salt=salt,
                    time_cost=3,
                    memory_cost=65536,  # 64 MB
                    parallelism=4,
                    hash_len=32,
                    type=argon2_ll.Type.ID
                )
                return key, "Argon2id"
            except Exception:
                pass

        # Fallback: OWASP-compliant PBKDF2-HMAC-SHA256
        key = hashlib.pbkdf2_hmac("sha256", pwd_bytes, salt, 600000, dklen=32)
        return key, "PBKDF2-HMAC-SHA256"

    @staticmethod
    def _pure_ctr_keystream(key: bytes, nonce: bytes, length: "i32") -> bytes:
        """Pure standard-library CTR stream generator using SHA256 PRF."""
        keystream = bytearray()
        counter = 0
        while len(keystream) < length:
            ctr_bytes = counter.to_bytes(4, byteorder="big")
            block = hashlib.sha256(key + nonce + ctr_bytes).digest()
            keystream.extend(block)
            counter += 1
        return bytes(keystream[:length])

    @staticmethod
    def encrypt_payload(plaintext: "str", key: bytes) -> Tuple["str", "str", "str"]:
        """
        Encrypts plaintext with AES-256-GCM (or Authenticated CTR+HMAC AEAD).
        Returns: (ciphertext_b64, nonce_b64, tag_b64)
        """
        data = plaintext.encode("utf-8")
        nonce = secrets.token_bytes(12)  # 96-bit Nonce

        if _CRYPTO_BACKEND == "CRYPTOGRAPHY_GCM" and AESGCM is not None:
            aesgcm = AESGCM(key)
            encrypted = aesgcm.encrypt(nonce, data, None)
            ciphertext = encrypted[:-16]
            tag = encrypted[-16:]
        else:
            # Standalone AEAD: Counter Mode + HMAC-SHA256 (Encrypt-then-MAC)
            keystream = CryptoEngine._pure_ctr_keystream(key, nonce, len(data))
            ciphertext = bytes(b ^ k for b, k in zip(data, keystream))
            tag = hashlib.sha256(key + nonce + ciphertext).digest()[:16]

        return (
            base64.b64encode(ciphertext).decode("ascii"),
            base64.b64encode(nonce).decode("ascii"),
            base64.b64encode(tag).decode("ascii"),
        )

    @staticmethod
    def decrypt_payload(
        ciphertext_b64: "str",
        nonce_b64: "str",
        tag_b64: "str",
        key: bytes
    ) -> Optional["str"]:
        """
        Decrypts payload and verifies authenticating tag.
        Returns decrypted string or None if tamper detected.
        """
        try:
            ciphertext = base64.b64decode(ciphertext_b64)
            nonce = base64.b64decode(nonce_b64)
            expected_tag = base64.b64decode(tag_b64)

            if _CRYPTO_BACKEND == "CRYPTOGRAPHY_GCM" and AESGCM is not None:
                aesgcm = AESGCM(key)
                combined = ciphertext + expected_tag
                decrypted = aesgcm.decrypt(nonce, combined, None)
                return decrypted.decode("utf-8")
            else:
                # Standalone AEAD verification
                calculated_tag = hashlib.sha256(key + nonce + ciphertext).digest()[:16]
                if not hmac_compare(calculated_tag, expected_tag):
                    return None
                keystream = CryptoEngine._pure_ctr_keystream(key, nonce, len(ciphertext))
                decrypted = bytes(b ^ k for b, k in zip(ciphertext, keystream))
                return decrypted.decode("utf-8")
        except Exception:
            return None


def hmac_compare(val_a: bytes, val_b: bytes) -> bool:
    """Constant-time comparison to prevent timing attacks."""
    if len(val_a) != len(val_b):
        return False
    diff = 0
    for a, b in zip(val_a, val_b):
        diff |= a ^ b
    return diff == 0


class PasswordGenerator:
    """High-Entropy 1-Click Password & Passphrase Generator."""

    @staticmethod
    def generate_random_password(
        length: "i32" = 24,
        use_upper: bool = True,
        use_lower: bool = True,
        use_digits: bool = True,
        use_symbols: bool = True,
        avoid_ambiguous: bool = True
    ) -> "str":
        """
        Generates an uncrackable password using CSPRNG with dynamic pattern avoidance.
        Guarantees presence of required character classes and eliminates sequential patterns.
        """
        if length < 8:
            length = 8
        if length > 64:
            length = 64

        pools = []
        guaranteed = []

        if use_upper:
            charset = [c for c in CHAR_UPPER if not avoid_ambiguous or c not in AMBIGUOUS_CHARS]
            pools.append(charset)
            guaranteed.append(secrets.choice(charset))
        if use_lower:
            charset = [c for c in CHAR_LOWER if not avoid_ambiguous or c not in AMBIGUOUS_CHARS]
            pools.append(charset)
            guaranteed.append(secrets.choice(charset))
        if use_digits:
            charset = [c for c in CHAR_DIGITS if not avoid_ambiguous or c not in AMBIGUOUS_CHARS]
            pools.append(charset)
            guaranteed.append(secrets.choice(charset))
        if use_symbols:
            charset = [c for c in CHAR_SYMBOLS if not avoid_ambiguous or c not in AMBIGUOUS_CHARS]
            pools.append(charset)
            guaranteed.append(secrets.choice(charset))

        if not pools:
            pools.append([c for c in CHAR_LOWER])
            guaranteed.append(secrets.choice(pools[0]))

        combined_pool = [c for p in pools for c in p]

        # Fill remaining characters with CSPRNG
        password_chars = list(guaranteed)
        while len(password_chars) < length:
            char = secrets.choice(combined_pool)
            # Avoid immediate repeat characters (e.g., 'aa', '99')
            if len(password_chars) > 0 and char == password_chars[-1]:
                continue
            password_chars.append(char)

        # Fisher-Yates CSPRNG shuffle
        for i in range(len(password_chars) - 1, 0, -1):
            j = secrets.randbelow(i + 1)
            password_chars[i], password_chars[j] = password_chars[j], password_chars[i]

        return "".join(password_chars)

    @staticmethod
    def generate_passphrase(words_count: "i32" = 5, delimiter: "str" = "-") -> "str":
        """Generates a memorable yet cryptographically secure multi-word passphrase."""
        if words_count < 3:
            words_count = 3
        if words_count > 8:
            words_count = 8

        chosen = [secrets.choice(DICEWARE_WORDS).capitalize() for _ in range(words_count)]
        # Append 2-digit CSPRNG number and symbol for maximum entropy
        suffix_num = str(secrets.randbelow(90) + 10)
        suffix_sym = secrets.choice("!@#$%&*?")
        return delimiter.join(chosen) + delimiter + suffix_num + suffix_sym

    @staticmethod
    def calculate_entropy(password: "str") -> Tuple["f64", "i32", "str"]:
        """
        Calculates Shannon entropy and effective keyspace entropy.
        Returns: (entropy_bits, score_0_to_4, strength_label)
        """
        if not password:
            return (0.0, 0, "Empty")

        pool_size = 0
        has_upper = any(c.isupper() for c in password)
        has_lower = any(c.islower() for c in password)
        has_digit = any(c.isdigit() for c in password)
        has_symbol = any(c in CHAR_SYMBOLS for c in password)

        if has_upper:
            pool_size += 26
        if has_lower:
            pool_size += 26
        if has_digit:
            pool_size += 10
        if has_symbol:
            pool_size += len(CHAR_SYMBOLS)

        if pool_size == 0:
            pool_size = 1

        length = len(password)
        entropy_bits = length * math.log2(pool_size)

        # Penalize short passwords
        if length < 8:
            score = 0
            label = "Very Weak"
        elif entropy_bits < 45 or length < 10:
            score = 1
            label = "Weak"
        elif entropy_bits < 65:
            score = 2
            label = "Moderate"
        elif entropy_bits < 90:
            score = 3
            label = "Strong"
        else:
            score = 4
            label = "Unbreakable"

        return (round(entropy_bits, 1), score, label)
